# Maintainer: Ali Utlu <alicgn at users.noreply.github.com>
pkgname=fylr
pkgver=0.2.0
pkgrel=1
pkgdesc="Fast disk analyzer, duplicate finder (BLAKE3) and file organizer for Linux"
arch=('x86_64')
url="https://github.com/ALICGN/fylr"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg')
makedepends=('cargo' 'nodejs' 'npm' 'pkgconf' 'patchelf')
optdepends=('ffmpeg: video metadata (duration, bitrate)'
            'ntfs-3g: write access on NTFS volumes')
provides=('fylr')
conflicts=('fylr-bin' 'fylr-git')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/ALICGN/fylr/archive/refs/tags/v${pkgver}.tar.gz"
        "${pkgname}-${pkgver}-vendor.tar.gz::https://github.com/ALICGN/fylr/releases/download/v${pkgver}/fylr-${pkgver}-vendor.tar.gz")
sha256sums=('SKIP'
            'SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  # Offline-Build aus dem mitgelieferten Crate-Archiv
  tar -xzf "${srcdir}/${pkgname}-${pkgver}-vendor.tar.gz" -C src-tauri
  mkdir -p src-tauri/.cargo
  cat > src-tauri/.cargo/config.toml <<'EOF'
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"
EOF
}

build() {
  cd "${pkgname}-${pkgver}"
  export CARGO_NET_OFFLINE=true
  npm ci --offline || npm install --no-audit --no-fund
  npm run build
  cd src-tauri
  cargo build --release --frozen --offline
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 src-tauri/target/release/fylr "${pkgdir}/usr/bin/fylr"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 src-tauri/icons/128x128.png \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/fylr.png"
  install -Dm644 src-tauri/icons/icon.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/fylr.svg" 2>/dev/null || true

  install -d "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/fylr.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Fylr
GenericName=Disk Analyzer
Comment=Scan disks, find duplicates, sort files
Exec=fylr
Icon=fylr
Terminal=false
Categories=Utility;FileTools;Qt;KDE;
Keywords=disk;duplicate;cleanup;sort;
StartupWMClass=fylr
EOF
}
